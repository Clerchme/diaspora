          "type": "column",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "text": "",
                  "bold": true
                }
              ],
              "align": "center"
            },
            {
              "type": "paragraph",
              "align": "center",
              "children": [
                {
                  "bold": true,
                  "text": ""
                }
              ]
            },
            {
              "type": "paragraph",
